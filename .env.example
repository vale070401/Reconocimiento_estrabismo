# JDBC del Session pooler de Supabase. El usuario identifica el proyecto ante el pooler.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?user=postgres.PROJECT_REF&sslmode=require
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION=3600000

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000

CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
PORT=8080

SENDGRID_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=false
MAIL_STARTTLS=true
